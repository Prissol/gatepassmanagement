<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Material Gate Pass Sequence -->
        <record id="sequence_material_gate_pass" model="ir.sequence">
            <field name="name">Material Gate Pass</field>
            <field name="code">gate.material.pass</field>
            <field name="prefix">MGP-</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Visitor Gate Pass Sequence -->
        <record id="sequence_visitor_gate_pass" model="ir.sequence">
            <field name="name">Visitor Gate Pass</field>
            <field name="code">gate.visitor.pass</field>
            <field name="prefix">VGP-</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Vehicle Gate Pass Sequence -->
        <record id="sequence_vehicle_gate_pass" model="ir.sequence">
            <field name="name">Vehicle Gate Pass</field>
            <field name="code">gate.vehicle.pass</field>
            <field name="prefix">VHP-</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>

