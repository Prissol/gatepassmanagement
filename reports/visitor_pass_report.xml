<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_visitor_gate_pass" name="Visitor Gate Pass">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page">
                    <div class="oe_structure"/>
                    <div class="row">
                        <div class="col-12">
                            <!-- Header Section -->
                            <div class="text-center mb-4" style="border-bottom: 3px solid #2E86AB; padding-bottom: 20px;">
                                <h1 style="color: #2E86AB; font-weight: bold; margin-bottom: 10px;">VISITOR GATE PASS</h1>
                                <p style="color: #666; font-size: 14px;">
                                    <t t-if="doc.company_id">
                                        <span t-field="doc.company_id.name"/>
                                        <t t-if="doc.company_id.street">, <span t-field="doc.company_id.street"/></t>
                                        <t t-if="doc.company_id.city">, <span t-field="doc.company_id.city"/></t>
                                        <t t-if="doc.company_id.country_id">, <span t-field="doc.company_id.country_id.name"/></t>
                                    </t>
                                </p>
                            </div>
                            
                            <!-- Pass Information -->
                            <div class="row mb-4">
                                <div class="col-6">
                                    <table class="table table-bordered" style="margin-bottom: 0;">
                                        <tr>
                                            <td style="width: 40%; background-color: #f8f9fa;"><strong>Visitor Pass Number:</strong></td>
                                            <td><span t-field="doc.name" style="font-weight: bold; font-size: 16px;"/></td>
                                        </tr>
                                        <tr>
                                            <td style="background-color: #f8f9fa;"><strong>Status:</strong></td>
                                            <td>
                                                <span t-if="doc.state == 'in'" style="color: #28a745; font-weight: bold;">✓ Checked In</span>
                                                <span t-if="doc.state == 'out'" style="color: #6c757d;">Checked Out</span>
                                            </td>
                                        </tr>
                                        <tr t-if="doc.card_no">
                                            <td style="background-color: #f8f9fa;"><strong>Badge Number:</strong></td>
                                            <td><span t-field="doc.card_no"/></td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="col-6">
                                    <table class="table table-bordered" style="margin-bottom: 0;">
                                        <tr>
                                            <td style="width: 40%; background-color: #f8f9fa;"><strong>Check-In Time:</strong></td>
                                            <td><span t-field="doc.check_in" t-options='{"widget": "datetime"}'/></td>
                                        </tr>
                                        <tr t-if="doc.check_out">
                                            <td style="background-color: #f8f9fa;"><strong>Check-Out Time:</strong></td>
                                            <td><span t-field="doc.check_out" t-options='{"widget": "datetime"}'/></td>
                                        </tr>
                                        <tr t-if="doc.duration">
                                            <td style="background-color: #f8f9fa;"><strong>Duration:</strong></td>
                                            <td><span t-esc="'%.2f' % doc.duration"/> Hours</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                            
                            <!-- Visitor Information -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h4 style="color: #2E86AB; border-bottom: 2px solid #2E86AB; padding-bottom: 5px;">Visitor Information</h4>
                                    <table class="table table-bordered">
                                        <tr>
                                            <td style="width: 20%; background-color: #f8f9fa;"><strong>Full Name:</strong></td>
                                            <td style="width: 30%;"><span t-field="doc.visitor_name"/></td>
                                            <td style="width: 20%; background-color: #f8f9fa;"><strong>Phone Number:</strong></td>
                                            <td style="width: 30%;"><span t-field="doc.visitor_phone"/></td>
                                        </tr>
                                        <tr t-if="doc.visitor_email">
                                            <td style="background-color: #f8f9fa;"><strong>Email Address:</strong></td>
                                            <td><span t-field="doc.visitor_email"/></td>
                                            <td style="background-color: #f8f9fa;"><strong>Mobile Number:</strong></td>
                                            <td><span t-field="doc.visitor_mobile"/></td>
                                        </tr>
                                        <tr>
                                            <td style="background-color: #f8f9fa;"><strong>ID Type:</strong></td>
                                            <td>
                                                <span t-if="doc.id_type == 'national_id'">National ID</span>
                                                <span t-if="doc.id_type == 'passport'">Passport</span>
                                                <span t-if="doc.id_type == 'driving_license'">Driving License</span>
                                                <span t-if="doc.id_type == 'company_id'">Company ID</span>
                                                <span t-if="doc.id_type == 'other'">Other</span>
                                            </td>
                                            <td style="background-color: #f8f9fa;"><strong>ID Number:</strong></td>
                                            <td><span t-field="doc.visitor_id_number"/><span t-if="doc.visitor_cnic and not doc.visitor_id_number" t-field="doc.visitor_cnic"/></td>
                                        </tr>
                                        <tr t-if="doc.company_name">
                                            <td style="background-color: #f8f9fa;"><strong>Company/Organization:</strong></td>
                                            <td colspan="3"><span t-field="doc.company_name"/></td>
                                        </tr>
                                        <tr t-if="doc.company_address">
                                            <td style="background-color: #f8f9fa;"><strong>Company Address:</strong></td>
                                            <td colspan="3"><span t-field="doc.company_address"/></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                            
                            <!-- Visit Details -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h4 style="color: #2E86AB; border-bottom: 2px solid #2E86AB; padding-bottom: 5px;">Visit Details</h4>
                                    <table class="table table-bordered">
                                        <tr>
                                            <td style="width: 20%; background-color: #f8f9fa;"><strong>Person to Meet:</strong></td>
                                            <td style="width: 30%;"><span t-field="doc.person_to_meet"/></td>
                                            <td style="width: 20%; background-color: #f8f9fa;"><strong>Department:</strong></td>
                                            <td style="width: 30%;"><span t-field="doc.department_to_visit"/></td>
                                        </tr>
                                        <tr>
                                            <td style="background-color: #f8f9fa;"><strong>Visit Type:</strong></td>
                                            <td>
                                                <span t-if="doc.visit_type == 'business'">Business Meeting</span>
                                                <span t-if="doc.visit_type == 'interview'">Job Interview</span>
                                                <span t-if="doc.visit_type == 'delivery'">Delivery/Pickup</span>
                                                <span t-if="doc.visit_type == 'maintenance'">Maintenance/Service</span>
                                                <span t-if="doc.visit_type == 'inspection'">Inspection/Audit</span>
                                                <span t-if="doc.visit_type == 'training'">Training</span>
                                                <span t-if="doc.visit_type == 'other'">Other</span>
                                            </td>
                                            <td style="background-color: #f8f9fa;"><strong>Expected Duration:</strong></td>
                                            <td><span t-if="doc.expected_duration" t-esc="'%.2f' % doc.expected_duration"/> Hours</td>
                                        </tr>
                                        <tr t-if="doc.vehicle_brought">
                                            <td style="background-color: #f8f9fa;"><strong>Vehicle Brought:</strong></td>
                                            <td>Yes</td>
                                            <td style="background-color: #f8f9fa;"><strong>Vehicle Number:</strong></td>
                                            <td><span t-field="doc.vehicle_number"/></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                            
                            <!-- Purpose -->
                            <div class="row mb-4" t-if="doc.purpose">
                                <div class="col-12">
                                    <h4 style="color: #2E86AB; border-bottom: 2px solid #2E86AB; padding-bottom: 5px;">Purpose of Visit</h4>
                                    <div style="border: 1px solid #dee2e6; padding: 15px; background-color: #f8f9fa; min-height: 60px;">
                                        <span t-field="doc.purpose"/>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Signatures -->
                            <div class="row mt-5">
                                <div class="col-6">
                                    <div style="border-top: 2px solid #000; padding-top: 10px; margin-top: 60px;">
                                        <strong>Visitor Signature:</strong>
                                        <div style="height: 50px; margin-top: 10px;"></div>
                                        <div style="margin-top: 5px;">
                                            <span t-field="doc.visitor_name"/>
                                        </div>
                                        <div style="font-size: 11px; color: #666;">
                                            <span t-field="doc.check_in" t-options='{"widget": "date"}'/>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div style="border-top: 2px solid #000; padding-top: 10px; margin-top: 60px;">
                                        <strong>Gate Officer Signature:</strong>
                                        <div style="height: 50px; margin-top: 10px;"></div>
                                        <div style="margin-top: 5px;" t-if="doc.gate_officer_id">
                                            <span t-field="doc.gate_officer_id"/>
                                        </div>
                                        <div style="font-size: 11px; color: #666;" t-if="doc.check_in">
                                            <span t-field="doc.check_in" t-options='{"widget": "date"}'/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Footer -->
                            <div class="row mt-4">
                                <div class="col-12 text-center" style="font-size: 11px; color: #666; border-top: 1px solid #dee2e6; padding-top: 10px;">
                                    <p>This is a computer-generated document. No signature is required.</p>
                                    <p>Generated on: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M:%S')"/></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="action_visitor_pass_report" model="ir.actions.report">
        <field name="name">Visitor Gate Pass</field>
        <field name="model">gate.visitor.pass</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gate_pass.report_visitor_gate_pass</field>
        <field name="report_file">gate_pass.report_visitor_gate_pass</field>
        <field name="print_report_name">'Visitor Gate Pass - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_gate_visitor_pass"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
