<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Visitor Gate Pass List View -->
    <record id="view_visitor_pass_tree" model="ir.ui.view">
        <field name="name">gate.visitor.pass.tree</field>
        <field name="model">gate.visitor.pass</field>
        <field name="arch" type="xml">
            <list string="Visitor Gate Pass" class="gate-pass-list" decoration-muted="state == 'out'" 
                  decoration-success="state == 'in'"
                  default_order="check_in desc">
                <field name="name" string="Pass Number"/>
                <field name="visitor_name"/>
                <field name="visitor_phone" string="Phone"/>
                <field name="company_name" string="Company"/>
                <field name="person_to_meet"/>
                <field name="visit_type"/>
                <field name="check_in" widget="datetime"/>
                <field name="check_out" widget="datetime"/>
                <field name="duration" string="Duration (Hrs)" widget="float"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'in'"
                       decoration-muted="state == 'out'"/>
            </list>
        </field>
    </record>

    <!-- Visitor Gate Pass Form View -->
    <record id="view_visitor_pass_form" model="ir.ui.view">
        <field name="name">gate.visitor.pass.form</field>
        <field name="model">gate.visitor.pass</field>
        <field name="arch" type="xml">
            <form string="Visitor Gate Pass" class="gate-pass-form">
                <header>
                    <button name="action_check_in" string="Check In" type="object" 
                            class="btn-primary" 
                            invisible="state != 'out'"
                            confirm="Check in this visitor?"/>
                    <button name="action_check_out" string="Check Out" type="object" 
                            class="btn-secondary"
                            invisible="state != 'in'"
                            confirm="Check out this visitor?"/>
                    <field name="state" widget="statusbar" statusbar_visible="in,out"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_visitor_pass_report)d" type="action" 
                                class="oe_stat_button" icon="fa-print" string="Print"/>
                        <button type="object" name="action_check_out" 
                                class="oe_stat_button" icon="fa-sign-out" 
                                string="Check Out" invisible="state != 'in'"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" class="oe_inline"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Visitor Information">
                            <field name="visitor_name" required="1"/>
                            <field name="visitor_first_name"/>
                            <field name="visitor_last_name"/>
                            <field name="visitor_email" widget="email"/>
                            <field name="visitor_phone"/>
                            <field name="visitor_mobile"/>
                        </group>
                        <group string="Identification">
                            <field name="id_type"/>
                            <field name="visitor_id_number" string="ID Number"/>
                            <field name="visitor_cnic" string="CNIC/NICOP"/>
                            <field name="card_no" string="Badge Number"/>
                        </group>
                    </group>
                    <group>
                        <group string="Company/Organization">
                            <field name="company_name"/>
                            <field name="company_address" widget="text"/>
                        </group>
                        <group string="Visit Details">
                            <field name="visit_type"/>
                            <field name="person_to_meet" required="1" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="department_to_visit" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="expected_duration" string="Expected Duration (Hrs)" widget="float"/>
                        </group>
                    </group>
                    <group>
                        <group string="Vehicle Information">
                            <field name="vehicle_brought"/>
                            <field name="vehicle_number" string="Vehicle Registration" 
                                   invisible="not vehicle_brought"/>
                        </group>
                        <group string="Timing">
                            <field name="check_in" widget="datetime" readonly="state == 'out' and not check_in"/>
                            <field name="check_out" widget="datetime" readonly="1"/>
                            <field name="duration" string="Duration (Hours)" widget="float" readonly="1"/>
                        </group>
                    </group>
                    <group string="Purpose of Visit">
                        <field name="purpose" placeholder="Please provide detailed purpose of visit..."/>
                    </group>
                    <notebook>
                        <page string="Gate Processing" name="gate">
                            <group>
                                <field name="gate_officer_id" readonly="state == 'out'"/>
                            </group>
                        </page>
                        <page string="Internal Notes" name="notes" groups="prissol_gate_pass.group_gate_pass_admin,prissol_gate_pass.group_department_manager">
                            <group>
                                <field name="notes" placeholder="Internal notes visible only to authorized personnel..."/>
                            </group>
                        </page>
                        <page string="History &amp; Tracking" name="history">
                            <group>
                                <group string="Timeline">
                                    <field name="check_in" widget="datetime" readonly="1"/>
                                    <field name="check_out" widget="datetime" readonly="1"/>
                                    <field name="duration" widget="float" readonly="1"/>
                                </group>
                                <group string="Audit Trail">
                                    <field name="create_date" widget="datetime" readonly="1"/>
                                    <field name="write_date" widget="datetime" readonly="1"/>
                                    <field name="create_uid" readonly="1"/>
                                    <field name="write_uid" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Visitor Gate Pass Search View -->
    <record id="view_visitor_pass_search" model="ir.ui.view">
        <field name="name">gate.visitor.pass.search</field>
        <field name="model">gate.visitor.pass</field>
        <field name="arch" type="xml">
            <search string="Visitor Gate Pass">
                <field name="name" string="Pass Number"/>
                <field name="visitor_name"/>
                <field name="visitor_id_number" string="ID Number"/>
                <field name="visitor_cnic"/>
                <field name="visitor_phone" string="Phone"/>
                <field name="visitor_email" string="Email"/>
                <field name="company_name"/>
                <field name="person_to_meet"/>
                <field name="card_no" string="Badge Number"/>
                <filter string="Checked In" name="in" domain="[('state', '=', 'in')]"/>
                <filter string="Checked Out" name="out" domain="[('state', '=', 'out')]"/>
                <separator/>
                <filter string="Currently Inside" name="currently_inside"
                        domain="[('state', '=', 'in')]"/>
                <filter string="Today" name="today" 
                        domain="[('check_in', '>=', datetime.datetime.now().replace(hour=0, minute=0, second=0))]"/>
                <filter string="This Week" name="this_week"
                        domain="[('check_in', '>=', (datetime.datetime.now() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month"
                        domain="[('check_in', '>=', datetime.datetime.now().replace(day=1).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Visit Type" name="group_visit_type" context="{'group_by': 'visit_type'}"/>
                    <filter string="Person to Meet" name="group_person" context="{'group_by': 'person_to_meet'}"/>
                    <filter string="Department" name="group_department" context="{'group_by': 'department_to_visit'}"/>
                    <filter string="Check In Date" name="group_check_in" context="{'group_by': 'check_in'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Visitor Gate Pass Action -->
    <record id="action_visitor_pass" model="ir.actions.act_window">
        <field name="name">Visitor Gate Pass</field>
        <field name="res_model">gate.visitor.pass</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_state': 'out', 'default_visit_type': 'business'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Visitor Gate Pass!
            </p>
            <p>
                Track visitor entry and exit with comprehensive visitor information.
                <ul>
                    <li>Record detailed visitor information and identification</li>
                    <li>Track check-in and check-out times</li>
                    <li>Monitor visitor duration and purpose</li>
                    <li>Generate professional visitor passes</li>
                </ul>
            </p>
        </field>
    </record>
</odoo>
