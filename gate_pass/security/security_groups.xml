<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_gate_pass_user" model="res.groups">
            <field name="name">Gate Pass User</field>
            <field name="category_id" ref="base.module_category_operations"/>
            <field name="comment">Can create gate passes and access the Gate Pass application.</field>
        </record>

        <record id="group_gate_officer" model="res.groups">
            <field name="name">Gate Officer</field>
            <field name="category_id" ref="base.module_category_operations"/>
            <field name="comment">Can create and manage gate passes. Cannot approve material passes.</field>
            <field name="implied_ids" eval="[(4, ref('group_gate_pass_user'))]"/>
        </record>

        <record id="group_department_manager" model="res.groups">
            <field name="name">Gate Pass Department Manager</field>
            <field name="category_id" ref="base.module_category_operations"/>
            <field name="comment">Can approve or reject material gate passes.</field>
            <field name="implied_ids" eval="[(4, ref('group_gate_pass_user'))]"/>
        </record>

        <record id="group_gate_pass_admin" model="res.groups">
            <field name="name">Gate Pass Administrator</field>
            <field name="category_id" ref="base.module_category_operations"/>
            <field name="comment">Full access to all gate pass operations.</field>
            <field name="implied_ids" eval="[(4, ref('group_department_manager')), (4, ref('group_gate_officer'))]"/>
        </record>
    </data>
</odoo>
